# Quorum — example environment. COPY to `.env` and fill in. `.env` is gitignored.
# These are only needed for API mode (Stage 2). Local mode uses your installed
# CLIs' own auth (OAuth/config) and needs NO keys here.
#
# NEVER commit a real key. NEVER paste a key into a URL, a commit, or an issue.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
